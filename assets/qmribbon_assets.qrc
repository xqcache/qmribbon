<RCC>
    <qresource prefix="/qmribbon/fonts">
        <file alias="uifont">fonts/uifont.ttf</file>
    </qresource>

    <qresource prefix="/qmribbon/styles">
        <file alias="default">styles/default.qss</file>
        <file alias="dark">styles/dark.qss</file>
        <file alias="light">styles/light.qss</file>
    </qresource>
    
    <qresource prefix="/qmribbon/icons">
        <file alias="expand">icons/expand.svg</file>
    </qresource>

    <qresource prefix="/qmribbon/images">
        <file alias="shadow_light">images/shadow_light.svg</file>
        <file alias="shadow_dark">images/shadow_dark.svg</file>
    </qresource>
</RCC>
