QmRibbonTitleBar {
    font-family: "Source Han Sans CN";
    font-weight: 500;
    font-size: 15pt;

    min-height: 40px;
    max-height: 40px;
}

QmRibbonTitleBar QToolButton[Style="WindowButton"] {
    padding: 5px;
    padding-left: 15px;
    padding-right: 15px;
    font-family: "uifont";
    border: none;
    font-size: 13pt;
    background: transparent;
}

QmRibbonTitleBar QToolButton[Style="RibbonApplicationLogo"] {
    border: none;
    background: transparent;
}

QmRibbonTitleBar #btn_win_minimized {
    qproperty-text: "\2100";
}

QmRibbonTitleBar #btn_win_close {
    qproperty-text: "\2103";
}

QmRibbonTitleBar #btn_win_close:hover {
    background-color: rgba(212, 64, 39, 255);
    color: white;
}

QmRibbonTabBar {
    border: none;
    min-height: 40px;
    max-height: 40px;
}

QmRibbonTabBar QToolButton {
    min-width: 64px;
    height: 14px;
    font-family: "Source Han Sans CN";
    font-weight: 500;
    font-size: 12pt;

    border: none;
    background: transparent;
    padding: 3px;
    margin: 2px;
    margin-bottom: 5px;
}

QmRibbonTabBar QToolButton[Style="RibbonTabButton"]:checked {
    padding-bottom: 0px;
}

QmRibbonTabBar QToolButton[Style="RibbonTabButton"]:hover {
    padding-bottom: 0px;
}

QmRibbonTabBar QToolButton[Style="RibbonTabButton"]:hover:checked {
    padding-bottom: 0px;
}

QmRibbonTabBar QToolButton[Style="RibbonApplicationButton"]:pressed {
    padding-top: 6px;
    padding-left: 6px;
}

QmRibbonPage QFrame[Style="RibbonSectionSeparator"] {
    margin-top: 5px;
    margin-bottom: 5px;
}

QmRibbonSection QToolButton[Style="RibbonSectionExpandButton"] {
    background: transparent;
    qproperty-icon: url(:/qmribbon/icons/expand);
}

QmRibbonPageContainer QmImageShadowWidget {
    qproperty-shadowPixmap: url(:/qmribbon/images/white_shadow_background);
    qproperty-contentGeometry: rect(10 10 580 580);
    qproperty-blurRadius: 5;
}
