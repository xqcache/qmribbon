<RCC>
    <!--
        主题资源：配色配置与样式表模板。
        QmRibbonTheme 通过 :/qmribbon/themes/... 读取，
        因此修改 resources/themes/ 下的文件后重新编译即可生效。
    -->
    <qresource prefix="/qmribbon/themes">
        <file alias="light.json">../../resources/themes/light.json</file>
        <file alias="dark.json">../../resources/themes/dark.json</file>
        <file alias="ribbon.qss">../../resources/themes/ribbon.qss</file>
    </qresource>

    <!--
        必须跟着主题明暗换色的小图标（QSS 只能给 url，给不了颜色）。
        由 QmRibbonTheme::asset() 按主题的 dark 标记挑选，模板里写 @{chevronDown}。
    -->
    <qresource prefix="/qmribbon/images">
        <file alias="chevron-down-light.svg">../../resources/images/chevron-down-light.svg</file>
        <file alias="chevron-down-dark.svg">../../resources/images/chevron-down-dark.svg</file>
        <file alias="chevron-up-light.svg">../../resources/images/chevron-up-light.svg</file>
        <file alias="chevron-up-dark.svg">../../resources/images/chevron-up-dark.svg</file>
    </qresource>
</RCC>
