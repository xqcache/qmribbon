@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(
    Qt6
    6.8
    CONFIG
    REQUIRED
    COMPONENTS
    Core
    Gui
    Widgets
    Svg
)

# 无边框窗口依赖 QWindowKit（随包一起安装，或由使用方自行提供）。
find_dependency(QWindowKit COMPONENTS Widgets)

# 停靠系统依赖 Qt Advanced Docking System。注意其包名带 Qt 主版本号。
find_dependency(qtadvanceddocking-qt6)

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")
